#!/usr/bin/env bash
# devbox git credential helper: GitHub via gh, Gitea via token file.
[ "$1" = "get" ] || exit 0
declare -A req
while IFS='=' read -r k v; do [ -n "$k" ] && req[$k]="$v"; done
host="${req[host]}"
[ -n "$host" ] || exit 0
if [ "$host" = "github.com" ]; then
  # gh's own helper resolves github.com from the mounted config
  gh auth git-credential get <<< "protocol=${req[protocol]}
host=$host" 2>/dev/null
  exit 0
fi
tokens=/run/devbox-git/gitea-tokens.json
if [ -f "$tokens" ]; then
  tok="$(jq -r --arg h "$host" 'to_entries[] | select(.key == $h) | .value' "$tokens" 2>/dev/null | head -1)"
  if [ -n "$tok" ] && [ "$tok" != "null" ]; then
    echo "protocol=${req[protocol]}"
    echo "host=$host"
    echo "username=devbox"
    echo "password=$tok"
  fi
fi
