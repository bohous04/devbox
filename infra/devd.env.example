# /etc/devd/devd.env — install-specific values. Read by devd.service and
# devbox-backup.service (EnvironmentFile=-, so the file is optional).
# After a change: systemctl restart devd

# Public dashboard URL (deep links in notifications). Without it notifications carry no link.
#DEVD_DASHBOARD_URL=https://dev.example.com

# Timezone of session containers. Default: the host timezone.
#DEVD_TZ=Europe/Prague

# Machine registry for the Hardware tab (template: infra/hardware.example.json).
#DEVD_HARDWARE=/etc/devd/hardware.json

# borg backup target for infra/devbox-backup.sh. The backup fails without DEVBOX_BORG_REPO.
#DEVBOX_BORG_REPO=ssh://root@backup.example.com:22/var/backups/devbox-borg
#DEVBOX_BORG_KEY=/root/.ssh/id_ed25519_backup
#DEVBOX_BORG_PASSFILE=/etc/devd/borg-passphrase
# borg binary on the remote side, e.g. borg-1.4 on a Hetzner Storage Box.
#DEVBOX_BORG_REMOTE_PATH=borg-1.4

# Projects whose app agents may restart through the broker (restart-app operation).
# Empty = restarting is not allowed for any project.
#DEVD_RESTART_PROJECTS=shop,blog

# Terminal sharing (Cloudflare tunnel without Access → localhost:4302): guest page at
# share.<domain>, previews at p0…p9.<domain>.
#DEVD_SHARE_HOST=share.example.com
#DEVD_PREVIEW_DOMAIN=example.com

# Isolate sessions with a Docker-in-Docker sidecar instead of the host Docker socket.
# Strongly recommended, see SECURITY.md.
#DEVD_DIND=1
