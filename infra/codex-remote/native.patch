+mod devbox_permission_config_override_tests {
+    use super::super::has_split_permission_config_override;
+    use pretty_assertions::assert_eq;
+    use serde_json::json;
+    use std::collections::HashMap;
+
+    #[test]
+    fn explicit_split_permission_tables_and_dotted_edits_block_saved_profile_restore() {
+        for key in [
+            "sandbox_mode",
+            "default_permissions",
+            "permissions",
+            "permissions.dev.filesystem",
+            "sandbox_workspace_write",
+            "sandbox_workspace_write.network_access",
+            "network",
+            "network.allowed_domains",
+        ] {
+            let overrides = HashMap::from([(key.to_string(), json!({}))]);
+            assert_eq!(has_split_permission_config_override(Some(&overrides)), true);
+        }
+        for key in [
+            "model",
+            "permissions_extra",
+            "networking",
+            "sandbox_workspace_write_extra",
+        ] {
+            let overrides = HashMap::from([(key.to_string(), json!({}))]);
+            assert_eq!(
+                has_split_permission_config_override(Some(&overrides)),
+                false
+            );
+        }
+        assert_eq!(has_split_permission_config_override(None), false);
+    }
+}
