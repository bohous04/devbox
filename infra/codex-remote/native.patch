+//! Opt-in host routing for a centrally managed fleet of devbox executors.
+
+use std::collections::HashMap;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_config::McpServerConfig;
+use codex_config::McpServerEnvVar;
+use codex_config::McpServerTransportConfig;
+use codex_exec_server::EnvironmentManager;
+use codex_protocol::protocol::TurnEnvironmentSelection;
+use serde::Deserialize;
+
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+
+const ROUTES_FILE_ENV: &str = "DEVD_CODEX_ROUTES_FILE";
+
+/// Resolve legacy persisted cwd before an app-server client loads project configuration.
+pub fn resolve_devbox_resume_cwd(
+    thread_id: &str,
+    cwd: Option<PathBuf>,
+) -> CodexResult<Option<PathBuf>> {
+    let Some(routes) = DevboxRoutes::load()? else {
+        return Ok(cwd);
+    };
+    Ok(cwd.map(|cwd| routes.legacy_cwd(thread_id, &cwd).unwrap_or(cwd)))
+}
+
+/// Whether saved and resumed authority belong to the same registered executor.
+/// Unconfigured, unmapped, cross-executor, and ambiguous legacy paths never opt in.
+pub fn is_registered_devbox_resume_cwd(
+    thread_id: &str,
+    saved_cwd: Option<&Path>,
+    effective_cwd: Option<&Path>,
+) -> CodexResult<bool> {
+    let Some(routes) = DevboxRoutes::load()? else {
+        return Ok(false);
+    };
+    Ok(routes.resume_keeps_executor(thread_id, saved_cwd, effective_cwd))
+}
+
+/// Resolve an exact project-root list filter without broadening subdirectory queries.
+pub fn resolve_devbox_list_project_id(cwds: &[PathBuf]) -> CodexResult<Option<String>> {
+    let Some(routes) = DevboxRoutes::load()? else {
+        return Ok(None);
+    };
+    Ok(routes.list_project_id(cwds).map(str::to_string))
+}
+
+/// Prepare executors only for explicit thread startup or an actual turn.
+/// Registry discovery, status, and MCP prewarming must never call this function.
+pub(crate) async fn prepare_devbox_environments(
+    selections: &[TurnEnvironmentSelection],
+) -> CodexResult<bool> {
+    let Some(routes) = DevboxRoutes::load()? else {
+        return Ok(false);
+    };
+    let Some(dispatcher) = std::env::var_os("DEVD_CODEX_EXEC_DISPATCH") else {
+        return Ok(false);
+    };
+    routes
+        .prepare_with_dispatch(Path::new(&dispatcher), selections)
+        .await?;
+    Ok(true)
+}
+
+#[derive(Deserialize)]
+pub(crate) struct DevboxRoutes {
+    routes: Vec<DevboxRoute>,
+}
+
+#[derive(Deserialize)]
+struct DevboxRoute {
+    cwd: PathBuf,
+    environment_id: String,
+    #[serde(default)]
+    project_id: Option<String>,
+    #[serde(default)]
+    thread_ids: Vec<String>,
+}
+
+impl DevboxRoutes {
+    fn resume_keeps_executor(
+        &self,
+        thread_id: &str,
+        saved_cwd: Option<&Path>,
+        effective_cwd: Option<&Path>,
+    ) -> bool {
+        let resolve = |cwd: Option<&Path>| {
+            let cwd = cwd?;
+            if !cwd.is_absolute()
+                || cwd
+                    .components()
+                    .any(|component| matches!(component, Component::ParentDir | Component::CurDir))
+            {
+                return None;
+            }
+            let canonical_cwd = self.legacy_cwd(thread_id, cwd);
+            if cwd.starts_with("/workspace") && canonical_cwd.is_none() {
+                return None;
+            }
+            self.environment_id(canonical_cwd.as_deref().unwrap_or(cwd))
+                .ok()
+        };
+        matches!((resolve(saved_cwd), resolve(effective_cwd)), (Some(saved), Some(effective)) if saved == effective)
+    }
+
+    fn list_project_id(&self, cwds: &[PathBuf]) -> Option<&str> {
+        let [cwd] = cwds else {
+            return None;
+        };
+        self.routes
+            .iter()
+            .find(|route| &route.cwd == cwd)
+            .and_then(|route| route.project_id.as_deref())
+    }
+
+    async fn prepare_with_dispatch(
+        &self,
+        dispatcher: &Path,
+        selections: &[TurnEnvironmentSelection],
+    ) -> CodexResult<()> {
+        if !dispatcher.is_absolute() || !dispatcher.is_file() {
+            return Err(CodexErr::InvalidRequest(
+                "DEVD_CODEX_EXEC_DISPATCH must name an existing absolute executable".to_string(),
+            ));
+        }
+        let mut prepared = std::collections::HashSet::new();
+        for selection in selections {
+            let cwd = selection.cwd.to_abs_path().map_err(|error| {
+                CodexErr::InvalidRequest(format!("invalid devbox working directory: {error}"))
+            })?;
+            let environment_id = self.environment_id(cwd.as_path())?;
+            if selection.environment_id != environment_id {
+                return Err(CodexErr::InvalidRequest(
+                    "devbox executor does not match its project".to_string(),
+                ));
+            }
+            if !prepared.insert(environment_id) {
+                continue;
+            }
+            let output = tokio::time::timeout(
+                std::time::Duration::from_secs(120),
+                tokio::process::Command::new(dispatcher)
+                    .args(["--prepare", "--environment-id", environment_id])
+                    .stdin(std::process::Stdio::null())
+                    .stdout(std::process::Stdio::null())
+                    .stderr(std::process::Stdio::piped())
+                    .kill_on_drop(true)
+                    .output(),
+            )
+            .await
+            .map_err(|_| {
+                CodexErr::InvalidRequest(format!(
+                    "preparing devbox executor `{environment_id}` timed out after 120 seconds"
+                ))
+            })?
+            .map_err(|error| {
+                CodexErr::InvalidRequest(format!(
+                    "cannot prepare devbox executor `{environment_id}`: {error}"
+                ))
+            })?;
+            if !output.status.success() {
+                let error = String::from_utf8_lossy(&output.stderr)
+                    .chars()
+                    .take(4096)
+                    .collect::<String>();
+                return Err(CodexErr::InvalidRequest(format!(
+                    "preparing devbox executor `{environment_id}` failed ({}): {}",
+                    output.status,
+                    error.trim()
+                )));
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn load() -> CodexResult<Option<Self>> {
+        let Some(path) = std::env::var_os(ROUTES_FILE_ENV) else {
+            return Ok(None);
+        };
+        let bytes = std::fs::read(path).map_err(|error| {
+            CodexErr::InvalidRequest(format!("cannot read devbox route registry: {error}"))
+        })?;
+        let routes: Self = serde_json::from_slice(&bytes).map_err(|error| {
+            CodexErr::InvalidRequest(format!("invalid devbox route registry: {error}"))
+        })?;
+        routes.validate()?;
+        Ok(Some(routes))
+    }
+
+    fn validate(&self) -> CodexResult<()> {
+        let mut paths = std::collections::HashSet::new();
+        let mut thread_ids = std::collections::HashSet::new();
+        for route in &self.routes {
+            if !route.cwd.is_absolute()
+                || route.cwd.parent().is_none()
+                || route
+                    .cwd
+                    .components()
+                    .any(|component| matches!(component, Component::ParentDir | Component::CurDir))
+                || route.environment_id.is_empty()
+                || route.environment_id == "local"
+                || route.project_id.as_ref().is_some_and(String::is_empty)
+                || !paths.insert(&route.cwd)
+                || route
+                    .thread_ids
+                    .iter()
+                    .any(|id| id.is_empty() || !thread_ids.insert(id))
+            {
+                return Err(CodexErr::InvalidRequest(
+                    "devbox routes require unique absolute project paths and non-local environment ids"
+                        .to_string(),
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    /// Restore a legacy container path using an authoritative history identity.
+    pub(crate) fn legacy_cwd(&self, thread_id: &str, cwd: &Path) -> Option<PathBuf> {
+        let relative = cwd.strip_prefix("/workspace").ok()?;
+        self.routes
+            .iter()
+            .find(|route| route.thread_ids.iter().any(|id| id == thread_id))
+            .map(|route| route.cwd.join(relative))
+    }
+
+    pub(crate) fn environment_id(&self, cwd: &Path) -> CodexResult<&str> {
+        self.routes
+            .iter()
+            .filter(|route| cwd.starts_with(&route.cwd))
+            .max_by_key(|route| route.cwd.components().count())
+            .map(|route| route.environment_id.as_str())
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest(format!(
+                    "no devbox executor is registered for {}; select its canonical project directory",
+                    cwd.display()
+                ))
+            })
+    }
+
+    pub(crate) fn validate_selections(
+        &self,
+        manager: &EnvironmentManager,
+        selections: &[TurnEnvironmentSelection],
+    ) -> CodexResult<()> {
+        let dispatcher = std::env::var_os("DEVD_CODEX_EXEC_DISPATCH").map(PathBuf::from);
+        self.validate_selections_with_dispatch(manager, selections, dispatcher.as_deref())
+    }
+
+    fn validate_selections_with_dispatch(
+        &self,
+        manager: &EnvironmentManager,
+        selections: &[TurnEnvironmentSelection],
+        dispatcher: Option<&Path>,
+    ) -> CodexResult<()> {
+        if selections.is_empty() {
+            return Err(CodexErr::InvalidRequest(
+                "a devbox thread requires a registered executor".to_string(),
+            ));
+        }
+        for selection in selections {
+            let cwd = selection.cwd.to_abs_path().map_err(|error| {
+                CodexErr::InvalidRequest(format!("invalid devbox working directory: {error}"))
+            })?;
+            let expected = self.environment_id(cwd.as_path())?;
+            if selection.environment_id == expected && manager.get_environment(expected).is_none() {
+                let dispatcher = dispatcher.filter(|path| path.is_absolute() && path.is_file())
+                    .ok_or_else(|| CodexErr::InvalidRequest(format!(
+                        "devbox executor `{expected}` is not registered and no absolute DEVD_CODEX_EXEC_DISPATCH is configured"
+                    )))?;
+                manager
+                    .materialize_stdio_environment(
+                        expected.to_string(),
+                        dispatcher.to_path_buf(),
+                        vec!["--environment-id".to_string(), expected.to_string()],
+                    )
+                    .map_err(|error| {
+                        CodexErr::InvalidRequest(format!(
+                            "cannot register devbox executor: {error}"
+                        ))
+                    })?;
+            }
+            if selection.environment_id != expected
+                || manager
+                    .get_environment(expected)
+                    .is_none_or(|environment| !environment.is_remote())
+            {
+                return Err(CodexErr::InvalidRequest(format!(
+                    "devbox executor `{expected}` is unavailable or does not match the selected environment"
+                )));
+            }
+            for root in &selection.workspace_roots {
+                let root = root.to_abs_path().map_err(|error| {
+                    CodexErr::InvalidRequest(format!("invalid devbox workspace root: {error}"))
+                })?;
+                if self.environment_id(root.as_path())? != expected {
+                    return Err(CodexErr::InvalidRequest(
+                        "devbox workspace roots must belong to the selected executor".to_string(),
+                    ));
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Project configured stdio servers into the thread's executor without copying host secrets.
+pub(crate) fn project_mcp_servers(
+    servers: &mut HashMap<String, McpServerConfig>,
+    selections: &[TurnEnvironmentSelection],
+) {
+    if std::env::var_os(ROUTES_FILE_ENV).is_none() {
+        return;
+    }
+    project_selected_mcp_servers(servers, selections);
+}
+
+fn project_selected_mcp_servers(
+    servers: &mut HashMap<String, McpServerConfig>,
+    selections: &[TurnEnvironmentSelection],
+) {
+    let primary = selections.first();
+    for server in servers.values_mut() {
+        if !server.is_local_environment() {
+            continue;
+        }
+        let McpServerTransportConfig::Stdio { env_vars, cwd, .. } = &mut server.transport else {
+            continue;
+        };
+        let Some(primary) = primary.filter(|selection| selection.environment_id != "local") else {
+            server.enabled = false;
+            continue;
+        };
+        server.environment_id = primary.environment_id.clone();
+        if cwd.is_none()
+            || cwd
+                .as_ref()
+                .is_some_and(|path| path.as_str() == "/workspace")
+        {
+            *cwd = Some(codex_utils_path_uri::LegacyAppPathString::from_string(
+                primary.cwd.inferred_native_path_string(),
+            ));
+        }
+        for variable in env_vars {
+            if variable.source().is_none() {
+                *variable = McpServerEnvVar::Config {
+                    name: variable.name().to_string(),
+                    source: Some("remote".to_string()),
+                };
+            }
+        }
+    }
+}
