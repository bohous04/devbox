+        let mut environments = self
+            .environments
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(environment) = environments.get(&environment_id) {
+            return Ok(Arc::clone(environment));
+        }
+        let environment = Arc::new(Environment::remote_with_transport(
+            ExecServerTransportParams::StdioCommand {
+                command: crate::client_api::StdioExecServerCommand {
+                    program: program.to_string_lossy().into_owned(),
+                    args,
+                    env: HashMap::new(),
+                    cwd: None,
+                },
+                initialize_timeout: std::time::Duration::from_secs(120),
+            },
+            self.local_runtime_paths.clone(),
+            self.http_client_factory.clone(),
+        ));
+        environments.insert(environment_id, Arc::clone(&environment));
+        Ok(environment)
+    }
