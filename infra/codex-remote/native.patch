+#[cfg(unix)]
+fn write_hook_dispatcher(temp: &TempDir) -> std::path::PathBuf {
+    let path = temp.path().join("dispatcher with spaces.py");
+    std::fs::write(
+        &path,
+        r#"#!/usr/bin/env python3
+import json, os, sys
+hook_env=json.loads(os.environ["DEVD_CODEX_HOOK_ENV"])
+assert os.environ.get("DEVD_CODEX_ROUTES_FILE") != "/hook-controlled-registry"
+assert os.environ.get("DEVD_CODEX_RUNTIME_DIR") != "/hook-controlled-runtime"
+assert os.environ.get("DEVD_CODEX_MOUNT_IMAGE") != "hook-controlled-image"
+with open(hook_env["HOOK_DISPATCH_CAPTURE"], "w") as capture:
+    json.dump(sys.argv[1:], capture)
+assert sys.argv[1] == "--cwd"
+assert sys.argv[3] == "--timeout-seconds"
+assert sys.argv[5] == "--"
+os.environ.update(hook_env)
+os.execvpe(sys.argv[6], sys.argv[6:], os.environ)
+"#,
+    )
+    .expect("write hook dispatcher");
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755))
+        .expect("make hook dispatcher executable");
+    path
+}
