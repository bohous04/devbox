+async fn a_new_route_materializes_one_lazy_executor_without_restarting_existing_connections() {
+    let routes = registry();
+    let manager = environment_manager_without_environments();
+    let directory = tempfile::tempdir().expect("dispatcher directory");
+    let dispatcher = directory.path().join("dispatch");
+    std::fs::write(&dispatcher, "fixture must not run during registration").expect("dispatcher");
+    routes
+        .validate_selections_with_dispatch(&manager, &[selection()], Some(&dispatcher))
+        .expect("materialize");
+    let first = manager.get_environment("devbox_one").expect("executor");
+    assert_eq!(
+        first.status().await,
+        codex_exec_server::EnvironmentObservedStatus::Pending
+    );
+    routes
+        .validate_selections_with_dispatch(&manager, &[selection()], /*dispatcher*/ None)
+        .expect("reuse");
+    let second = manager
+        .get_environment("devbox_one")
+        .expect("same executor");
+    assert!(std::sync::Arc::ptr_eq(&first, &second));
+    let mut unknown = selection();
+    unknown.environment_id = "unrelated".to_string();
+    assert!(
+        routes
+            .validate_selections_with_dispatch(&manager, &[unknown], Some(&dispatcher))
