+#[test]
+fn saved_permissions_stay_with_the_same_registered_executor() {
+    let routes = registry();
+    for (saved, effective, expected) in [
+        ("/srv/dev/one", "/srv/dev/one/src", true),
+        ("/srv/dev/one/src", "/srv/dev/one", true),
+        ("/workspace", "/srv/dev/one/src", true),
+        ("/srv/dev/one", "/workspace/src", true),
+        ("/srv/dev/one", "/srv/dev/two", false),
+        ("/srv/dev/one", "/srv/dev/one/nested", false),
+        ("/srv/dev/one", "/outside", false),
+        ("/outside", "/srv/dev/one", false),
+        ("/srv/dev/one", "src", false),
+        ("/srv/dev/one", "/srv/dev/one/../two", false),
+    ] {
+        assert_eq!(
+            routes.resume_keeps_executor(
+                "legacy-one",
+                Some(Path::new(saved)),
+                Some(Path::new(effective)),
+            ),
+            expected
+        );
+    }
+    assert_eq!(
+        routes.resume_keeps_executor(
+            "unmapped",
+            Some(Path::new("/workspace")),
+            Some(Path::new("/srv/dev/one")),
+        ),
+        false
+    );
+    assert_eq!(
+        routes.resume_keeps_executor("legacy-one", None, Some(Path::new("/srv/dev/one"))),
+        false
+    );
+}
