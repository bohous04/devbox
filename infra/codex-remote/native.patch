+    /// Materialize a lazy stdio executor, preserving any existing environment and connection.
+    /// Registration does not spawn the command; its first operation does.
+    pub fn materialize_stdio_environment(
+        &self,
+        environment_id: String,
+        program: std::path::PathBuf,
+        args: Vec<String>,
