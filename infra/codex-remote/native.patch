+#[tokio::test]
+async fn legacy_devbox_resume_loads_canonical_project_config_without_rewriting_history()
+-> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("fixture complete").await;
+    let home = TempDir::new()?;
+    let project = TempDir::new()?;
+    let project_path = std::fs::canonicalize(project.path())?;
+    MockResponsesConfig::new(&server.uri())
+        .with_model("gpt-5.4")
+        .write(home.path())?;
+    let config_path = home.path().join("config.toml");
+    let config = std::fs::read_to_string(&config_path)?;
+    std::fs::write(
+        &config_path,
+        format!(
+            "{config}\n[projects.{}]\ntrust_level = \"trusted\"\n",
+            serde_json::to_string(&project_path.to_string_lossy())?,
+        ),
+    )?;
+    std::fs::create_dir(project_path.join(".codex"))?;
+    std::fs::write(
+        project_path.join(".codex/config.toml"),
+        "developer_instructions = 'DEVBOX_CANONICAL_CONFIG_FIXTURE'\n",
+    )?;
+    let id = create_fake_rollout(
+        home.path(),
+        "2025-01-05T12-00-00",
+        "2025-01-05T12:00:00Z",
+        "Legacy fixture",
+        Some("mock_provider"),
+        /*git_info*/ None,
+    )?;
+    let path = rollout_path(home.path(), "2025-01-05T12-00-00", &id);
+    // Construct an old container rollout before any app-server opens it.
+    let mut lines: Vec<serde_json::Value> = std::fs::read_to_string(&path)?
+        .lines()
+        .map(serde_json::from_str)
+        .collect::<std::result::Result<_, _>>()?;
+    lines[0]["payload"]["cwd"] = json!("/workspace");
+    let original = lines
+        .iter()
+        .map(serde_json::to_string)
+        .collect::<std::result::Result<Vec<_>, _>>()?
+        .join("\n")
+        + "\n";
+    std::fs::write(&path, &original)?;
+    let routes_path = home.path().join("devbox-routes.json");
+    std::fs::write(
+        &routes_path,
+        serde_json::to_vec(&json!({"routes":[{
+            "cwd": project_path, "environment_id":"remote", "thread_ids":[id]
+        }]}))?,
+    )?;
+    let routes_string = routes_path.to_string_lossy().to_string();
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .with_exec_server_delay(Duration::ZERO)
+        .with_env_overrides(&[("DEVD_CODEX_ROUTES_FILE", Some(&routes_string))])
+        .build_initialized()
+        .await?;
+    let created: ProjectCreateResponse = app
+        .request(|request_id| ClientRequest::ProjectCreate {
+            request_id,
+            params: ProjectCreateParams {
+                name: "Devbox fixture".to_string(),
+                roots: Vec::new(),
+                metadata: None,
+                idempotency_key: "devbox-fixture".to_string(),
+            },
+        })
+        .await?;
+    let _: ThreadMetadataUpdateResponse = app
+        .request(|request_id| ClientRequest::ThreadMetadataUpdate {
+            request_id,
+            params: ThreadMetadataUpdateParams {
+                thread_id: id.clone(),
+                project_id: Some(created.project.id.clone()),
+                git_info: None,
+                daybreak_enabled: None,
+            },
+        })
+        .await?;
+    std::fs::write(
+        &routes_path,
+        serde_json::to_vec(&json!({"routes":[{
+            "cwd": project_path, "environment_id":"remote", "thread_ids":[id],
+            "project_id": created.project.id
+        }]}))?,
+    )?;
+    for cwd in [json!(project_path), json!([project_path])] {
+        let listed: ThreadListResponse = app
+            .request(|request_id| ClientRequest::ThreadList {
+                request_id,
+                params: serde_json::from_value(json!({"cwd": cwd, "limit": 1}))
+                    .expect("list params"),
+            })
+            .await?;
+        assert_eq!(listed.data.len(), 1);
+        assert_eq!(listed.data[0].id, id);
+        assert_eq!(listed.data[0].cwd.as_path(), project_path.as_path());
+        assert_eq!(listed.next_cursor, None);
+    }
+    // Explicit project filters, title filters, and subdirectory queries retain
+    // their original meaning rather than being broadened by the route registry.
+    for params in [
+        json!({"cwd": project_path, "projectId": null}),
+        json!({"cwd": project_path, "projectId": created.project.id}),
+        json!({"cwd": project_path, "searchTerm": "not-the-fixture-title"}),
+        json!({"cwd": project_path.join("src")}),
+    ] {
+        let listed: ThreadListResponse = app
+            .request(|request_id| ClientRequest::ThreadList {
+                request_id,
+                params: serde_json::from_value(params).expect("list params"),
+            })
+            .await?;
+        assert!(listed.data.is_empty());
+    }
+    let read: ThreadReadResponse = app
+        .request(|request_id| ClientRequest::ThreadRead {
+            request_id,
+            params: ThreadReadParams {
+                thread_id: id.clone(),
+                include_turns: false,
+            },
+        })
+        .await?;
+    assert_eq!(read.thread.cwd.as_path(), project_path.as_path());
+    let request = app
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let response: ThreadResumeResponse =
+        timeout(Duration::from_secs(20), app.read_response(request)).await??;
+    assert_eq!(response.cwd.as_path(), project_path.as_path());
+    assert_eq!(response.thread.cwd.as_path(), project_path.as_path());
+    assert_eq!(response.thread.id, id);
+    timeout(
+        Duration::from_secs(20),
+        app.start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: id,
+            input: vec![UserInput::Text {
+                text: "fixture".to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        }),
+    )
+    .await??;
+    let requests = server.received_requests().await.expect("fixture requests");
+    assert!(requests.iter().any(|request| {
+        String::from_utf8_lossy(&request.body).contains("DEVBOX_CANONICAL_CONFIG_FIXTURE")
+    }));
+    let fresh: ThreadStartResponse = app
+        .request(|request_id| ClientRequest::ThreadStart {
+            request_id,
+            params: ThreadStartParams {
+                cwd: Some(project_path.to_string_lossy().to_string()),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(fresh.thread.project_id, Some(created.project.id));
+    app.shutdown_gracefully().await?;
+    assert!(std::fs::read(&path)?.starts_with(original.as_bytes()));
+    Ok(())
+}
