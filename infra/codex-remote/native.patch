+/// Runs the hook through the devbox dispatcher, which executes it inside the project container.
+#[cfg(unix)]
+fn build_dispatched_command(
+    dispatcher: &OsStr,
+    runtime: &CommandHookRuntime,
+    handler: &ConfiguredHandler,
+    command_line: &str,
+    env: &HashMap<String, String>,
+    cwd: &Path,
+) -> Command {
+    let mut command = Command::new(dispatcher);
+    command
+        .arg("--cwd")
+        .arg(cwd)
+        .arg("--timeout-seconds")
+        .arg(handler.timeout_sec.to_string())
+        .arg("--");
+    if runtime.shell.program.is_empty() {
+        command
+            .arg(default_shell_program(&runtime.environment))
+            .arg("-lc");
+    } else {
+        command.arg(&runtime.shell.program).args(&runtime.shell.args);
+    }
+    command.arg(command_line);
+    command.process_mode(codex_utils_pty::ProcessMode::NewSession);
+    // Host policy and executable lookup must not be controlled by hook.env.
+    // The dispatcher applies only explicit hook overrides inside Docker.
+    command
+        .envs(
+            runtime
+                .hook_dispatch_environment
+                .iter()
+                .map(|(key, value)| (key.as_os_str(), value.as_os_str()))
+                .filter(|(key, _)| !key.to_str().is_some_and(is_non_inheritable_env_var)),
+        )
+        .env(
+            "DEVD_CODEX_HOOK_ENV",
+            serde_json::to_string(env).expect("serialize string hook environment"),
+        );
+    command
+}
