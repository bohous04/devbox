@@ -0,0 +1,84 @@
+#![cfg(unix)]
+
+mod common;
+
+use std::time::Duration;
+
+use codex_exec_server::EnvironmentManager;
+use codex_exec_server::EnvironmentObservedStatus;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use pretty_assertions::assert_eq;
+use tokio::time::sleep;
+use tokio::time::timeout;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn stopped_stdio_executor_restarts_only_on_a_new_operation() -> anyhow::Result<()> {
+    let directory = tempfile::tempdir()?;
+    let script = directory.path().join("executor.sh");
+    let starts = directory.path().join("starts");
+    let pid = directory.path().join("pid");
+    let helpers = common::exec_server::test_codex_helper_paths()?;
+    std::fs::write(
+        &script,
+        "#!/bin/sh\nprintf x >> \"$2\"\nprintf '%s' \"$$\" > \"$3\"\nexec \"$1\" exec-server --listen stdio\n",
+    )?;
+    let args = [&script, &helpers.codex_exe, &starts, &pid];
+    let config = format!(
+        "default = \"devbox\"\ninclude_local = false\n[[environments]]\nid = \"devbox\"\nprogram = \"/bin/sh\"\nargs = {}\ninitialize_timeout_sec = 5\n[environments.env]\nCODEX_HOME = {}\n",
+        serde_json::to_string(&args)?,
+        serde_json::to_string(directory.path())?,
+    );
+    std::fs::write(directory.path().join("environments.toml"), config)?;
+    let manager = EnvironmentManager::from_codex_home(
+        directory.path(),
+        /*local_runtime_paths*/ None,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    )
+    .await?;
+    let environment = manager
+        .get_environment("devbox")
+        .expect("registered executor");
+    assert_eq!(
+        environment.status().await,
+        EnvironmentObservedStatus::Pending
+    );
+    assert!(!starts.exists());
+
+    let first = timeout(Duration::from_secs(10), environment.info()).await??;
+    assert_eq!(std::fs::read(&starts)?, b"x");
+    let process_id: i32 = std::fs::read_to_string(&pid)?.parse()?;
+    // The PID belongs to the dedicated fixture process started above.
+    assert!(
+        std::process::Command::new("kill")
+            .args(["-TERM", &process_id.to_string()])
+            .status()?
+            .success()
+    );
+    timeout(Duration::from_secs(5), async {
+        loop {
+            if matches!(
+                environment.status().await,
+                EnvironmentObservedStatus::Disconnected { .. }
+            ) {
+                break;
+            }
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await?;
+    for _ in 0..3 {
+        assert!(matches!(
+            environment.status().await,
+            EnvironmentObservedStatus::Disconnected { .. }
+        ));
+        sleep(Duration::from_millis(25)).await;
+    }
+    assert_eq!(std::fs::read(&starts)?, b"x");
+
+    let (second, concurrent) = tokio::join!(environment.info(), environment.info());
+    assert_eq!(second?, first);
+    assert_eq!(concurrent?, first);
+    assert_eq!(std::fs::read(&starts)?, b"xx");
+    Ok(())
+}
