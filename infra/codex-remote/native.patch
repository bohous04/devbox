+#[tokio::test]
+async fn devbox_cold_resume_preserves_unnamed_permissions_and_explicit_overrides() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    for history_mode in [ThreadHistoryMode::Legacy, ThreadHistoryMode::Paginated] {
+        for original_policy in [
+            codex_protocol::protocol::SandboxPolicy::DangerFullAccess,
+            codex_protocol::protocol::SandboxPolicy::new_read_only_policy(),
+            codex_protocol::protocol::SandboxPolicy::new_workspace_write_policy(),
+        ] {
+            let home = TempDir::new()?;
+            let project = TempDir::new()?;
+            let project_path = std::fs::canonicalize(project.path())?;
+            MockResponsesConfig::new(&server.uri())
+                .with_model("gpt-5.4")
+                .with_root_config("default_permissions = \":workspace\"")
+                .write(home.path())?;
+            let registry = home.path().join("devbox-routes.json");
+            std::fs::write(
+                &registry,
+                serde_json::to_vec(&json!({"routes": [{
+                    "cwd": project_path, "environment_id": "remote"
+                }]}))?,
+            )?;
+            let registry_string = registry.to_string_lossy().to_string();
+            let original_sandbox = AppSandboxPolicy::from(original_policy);
+            let thread_id = {
+                let mut app = TestAppServer::builder()
+                    .with_codex_home(home.path())
+                    .without_managed_config()
+                    .with_exec_server_delay(Duration::ZERO)
+                    .with_env_overrides(&[("DEVD_CODEX_ROUTES_FILE", Some(&registry_string))])
+                    .build_initialized()
+                    .await?;
+                let started: ThreadStartResponse = app
+                    .request(|request_id| ClientRequest::ThreadStart {
+                        request_id,
+                        params: ThreadStartParams {
+                            cwd: Some(project_path.to_string_lossy().to_string()),
+                            history_mode: Some(history_mode),
+                            ..Default::default()
+                        },
+                    })
+                    .await?;
+                timeout(
+                    Duration::from_secs(20),
+                    app.start_turn_and_wait_for_completion(TurnStartParams {
+                        thread_id: started.thread.id.clone(),
+                        input: vec![UserInput::Text {
+                            text: "persist explicit devbox permissions".to_string(),
+                            text_elements: Vec::new(),
+                        }],
+                        approval_policy: Some(AskForApproval::Never),
+                        sandbox_policy: Some(original_sandbox.clone()),
+                        ..Default::default()
+                    }),
+                )
+                .await??;
+                app.shutdown_gracefully().await?;
+                started.thread.id
+            };
+            for override_selection in [None, Some("sandbox"), Some("profile"), Some("config")] {
+                let mut app = TestAppServer::builder()
+                    .with_codex_home(home.path())
+                    .without_managed_config()
+                    .with_exec_server_delay(Duration::ZERO)
+                    .with_env_overrides(&[("DEVD_CODEX_ROUTES_FILE", Some(&registry_string))])
+                    .build_initialized()
+                    .await?;
+                let mut params = ThreadResumeParams {
+                    thread_id: thread_id.clone(),
+                    ..Default::default()
+                };
+                match override_selection {
+                    None => {}
+                    Some("sandbox") => params.sandbox = Some(SandboxMode::ReadOnly),
+                    Some("profile") => params.permissions = Some(":read-only".to_string()),
+                    Some("config") => {
+                        params.config = Some(std::collections::HashMap::from([(
+                            "sandbox_mode".to_string(),
+                            json!("read-only"),
+                        )]));
+                    }
+                    Some(_) => unreachable!(),
+                }
+                let request = app.send_thread_resume_request(params).await?;
+                let response: ThreadResumeResponse =
+                    timeout(Duration::from_secs(20), app.read_response(request)).await??;
+                if override_selection.is_some() {
+                    assert!(matches!(
+                        response.sandbox,
+                        AppSandboxPolicy::ReadOnly { .. }
+                    ));
+                } else {
+                    assert_eq!(response.sandbox, original_sandbox);
+                }
+                assert_eq!(response.approval_policy, AskForApproval::Never);
+                assert_eq!(
+                    response.active_permission_profile,
+                    (override_selection == Some("profile"))
+                        .then(ActivePermissionProfile::read_only)
+                );
+                app.shutdown_gracefully().await?;
+            }
+        }
+    }
+    Ok(())
+}
