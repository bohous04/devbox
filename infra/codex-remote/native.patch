+fn registry() -> DevboxRoutes {
+    serde_json::from_value(serde_json::json!({"routes":[
+        {"cwd":"/srv/dev/one", "environment_id":"devbox_one", "project_id":"project_one", "thread_ids":["legacy-one", "child-one"]},
+        {"cwd":"/srv/dev/one/nested", "environment_id":"devbox_nested"},
