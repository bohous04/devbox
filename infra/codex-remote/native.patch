+#[tokio::test]
+async fn devbox_saved_permissions_do_not_cross_executors_or_override_daemon_flags() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    for (scenario, daemon_flags) in [
+        ("same-executor", Vec::new()),
+        ("different-executor", Vec::new()),
+        ("daemon-sandbox", vec!["-c", "sandbox_mode=\"read-only\""]),
+        (
+            "daemon-profile",
