+        ),
+    ] {
+        let home = TempDir::new()?;
+        let source = TempDir::new()?;
+        let destination = TempDir::new()?;
+        let source_path = std::fs::canonicalize(source.path())?;
+        let destination_path = std::fs::canonicalize(destination.path())?;
+        let subdir = source_path.join("src");
+        std::fs::create_dir(&subdir)?;
+        MockResponsesConfig::new(&server.uri())
+            .with_model("gpt-5.4")
+            .with_root_config("default_permissions = \":workspace\"")
+            .write(home.path())?;
+        let registry = home.path().join("devbox-routes.json");
+        std::fs::write(
+            &registry,
+            serde_json::to_vec(&json!({"routes": [{
+                "cwd": source_path, "environment_id": "remote"
+            }]}))?,
+        )?;
+        let registry_string = registry.to_string_lossy().to_string();
+        let thread_id = {
+            let mut app = TestAppServer::builder()
+                .with_codex_home(home.path())
+                .without_managed_config()
+                .with_exec_server_delay(Duration::ZERO)
+                .with_env_overrides(&[("DEVD_CODEX_ROUTES_FILE", Some(&registry_string))])
+                .build_initialized()
+                .await?;
+            let started: ThreadStartResponse = app
+                .request(|request_id| ClientRequest::ThreadStart {
+                    request_id,
+                    params: ThreadStartParams {
+                        cwd: Some(source_path.to_string_lossy().to_string()),
+                        history_mode: Some(ThreadHistoryMode::Paginated),
+                        ..Default::default()
+                    },
+                })
+                .await?;
+            timeout(
+                Duration::from_secs(20),
+                app.start_turn_and_wait_for_completion(TurnStartParams {
+                    thread_id: started.thread.id.clone(),
+                    input: vec![UserInput::Text {
+                        text: "persist explicit full access in the source executor".to_string(),
+                        text_elements: Vec::new(),
+                    }],
+                    approval_policy: Some(AskForApproval::Never),
+                    sandbox_policy: Some(AppSandboxPolicy::DangerFullAccess),
+                    ..Default::default()
+                }),
+            )
+            .await??;
+            app.shutdown_gracefully().await?;
+            started.thread.id
+        };
+        let effective_cwd = if scenario == "different-executor" {
+            // The fixture exposes one live executor at a time. On the second
+            // daemon it belongs to the destination, distinct from the saved source.
+            std::fs::write(
+                &registry,
+                serde_json::to_vec(&json!({"routes": [
+                    {"cwd": source_path, "environment_id": "source-remote"},
+                    {"cwd": destination_path, "environment_id": "remote"}
+                ]}))?,
+            )?;
+            destination_path
+        } else {
+            subdir
+        };
+        let mut app = TestAppServer::builder()
+            .with_codex_home(home.path())
+            .without_managed_config()
+            .with_exec_server_delay(Duration::ZERO)
+            .with_env_overrides(&[("DEVD_CODEX_ROUTES_FILE", Some(&registry_string))])
+            .with_args(&daemon_flags)
+            .build_initialized()
+            .await?;
+        let request = app
+            .send_thread_resume_request(ThreadResumeParams {
+                thread_id: thread_id.clone(),
+                cwd: Some(effective_cwd.to_string_lossy().to_string()),
+                ..Default::default()
+            })
+            .await?;
+        let response: ThreadResumeResponse =
+            timeout(Duration::from_secs(20), app.read_response(request)).await??;
+        let (sandbox, cwd) = (response.sandbox, response.cwd);
+        assert_eq!(cwd.as_path(), effective_cwd.as_path());
+        match scenario {
+            "same-executor" => assert_eq!(sandbox, AppSandboxPolicy::DangerFullAccess),
+            "different-executor" => {
+                assert!(matches!(sandbox, AppSandboxPolicy::WorkspaceWrite { .. }))
+            }
+            "daemon-sandbox" | "daemon-profile" => {
+                assert!(matches!(sandbox, AppSandboxPolicy::ReadOnly { .. }))
+            }
+            _ => unreachable!(),
+        }
+        app.shutdown_gracefully().await?;
+    }
+    Ok(())
+}
