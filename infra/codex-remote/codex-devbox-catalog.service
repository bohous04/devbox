[Unit]
Description=Persistent project catalog for the devbox Codex Remote server
After=docker.service codex-remote-control.service
Wants=docker.service
Wants=codex-remote-control.service

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/codex-devbox/sync.py --registry /etc/codex-devbox/routes.json --home /var/lib/docker/volumes/codex-home/_data --socket /var/lib/docker/volumes/codex-home/_data/app-server-control/app-server-control.sock --interval 5
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
